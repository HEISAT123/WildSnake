{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.cs)|Write(*.cs)",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/check-compile.ps1",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
