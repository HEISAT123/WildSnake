{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.cs)|Write(*.cs)",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/check-compile.ps1",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "env": {
    "UNITY_EXE": "C:\\Program Files\\Unity\\Hub\\Editor\\6000.6.5f1\\Editor\\Unity.exe"
  }
}
