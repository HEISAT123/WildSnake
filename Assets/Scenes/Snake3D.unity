    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 22
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.15
  m_Text: "\u0417\u043C\u0435\u044F \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u043A\u0440\u043E\u0432\u043D\u0430: \u043D\u0430 \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u043C \u043A\u0430\u043C\u043D\u0435 \u0433\u0440\u0435\u0435\u0442\u0441\u044F, \u043D\u043E\u0447\u044C\u044E \u0438 \u0432 \u0432\u043E\u0434\u0435 \u043C\u0451\u0440\u0437\u043D\u0435\u0442 \u2014 \u0438\u043D\u0435\u0439 \u043F\u043E \u043A\u0440\u0430\u044F\u043C \u044D\u043A\u0440\u0430\u043D\u0430.\n\nE \u0443 \u043D\u043E\u0440\u044B \u2014 \u0432\u043E\u0439\u0442\u0438: \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F, \u043D\u043E\u0447\u044C \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435.\n\nTAB \u2014 \u043A\u0430\u0440\u0442\u0430 \u0438 \u0446\u0435\u043B\u0438 \u0434\u043D\u044F. H \u2014 \u0441\u043A\u0440\u044B\u0442\u044C \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441."
