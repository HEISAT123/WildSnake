    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.15
  m_Text: "\u0412\u044B\u0441\u043E\u043A\u0430\u044F \u0442\u0440\u0430\u0432\u0430 \u043F\u0440\u044F\u0447\u0435\u0442 \u0437\u043C\u0435\u044E.\n\n\u0414\u043E\u0431\u044B\u0447\u0430 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442 \u0432\u0430\u0441 \u0432 \u0434\u0432\u0430 \u0440\u0430\u0437\u0430 \u043F\u043E\u0437\u0436\u0435, \u0430 \u0431\u0440\u043E\u0441\u043E\u043A, \u043D\u0430\u043E\u0431\u043E\u0440\u043E\u0442, \u0432\u044B\u0434\u0430\u0451\u0442.\n\n\u041E\u0440\u0451\u043B \u043D\u0435 \u0432\u0438\u0434\u0438\u0442 \u0437\u043C\u0435\u044E \u0432 \u0442\u0440\u0430\u0432\u0435 \u0438 \u0443\u043B\u0435\u0442\u0430\u0435\u0442 \u043D\u0438 \u0441 \u0447\u0435\u043C.\n\n\u0412 \u043F\u0440\u044B\u0436\u043A\u0435 \u0443\u043A\u0440\u044B\u0442\u0438\u044F \u043D\u0435\u0442."
