    m_VerticalOverflow: 1
    m_LineSpacing: 1.15
  m_Text: "E \u2014 \u043D\u044E\u0445: \u044F\u0437\u044B\u043A \u043F\u043E\u043A\u0430\u0436\u0435\u0442 \u0441\u043B\u0435\u0434 \u043A \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0439 \u0434\u043E\u0431\u044B\u0447\u0435 \u0438 \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u0438\u0442 \u0432\u0441\u0435\u0445 \u0432\u043E\u043A\u0440\u0443\u0433.\n\n\u041D\u0430\u0431\u0440\u0430\u0432 \u0440\u043E\u0441\u0442, \u0437\u043C\u0435\u044F \u043B\u0438\u043D\u044F\u0435\u0442: \u0440\u0430\u043D\u044B \u0437\u0430\u0442\u044F\u0433\u0438\u0432\u0430\u044E\u0442\u0441\u044F, \u0430 \u0432\u044B \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0435 \u043E\u0434\u043D\u043E \u0438\u0437 \u0442\u0440\u0451\u0445 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0439.\n\n\u041F\u043E\u043A\u0430 \u0437\u043C\u0435\u044F \u0441\u044B\u0442\u0430, \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
