    m_VerticalOverflow: 1
    m_LineSpacing: 1.15
  m_Text: "\u041E\u0440\u0451\u043B \u043E\u0445\u043E\u0442\u0438\u0442\u0441\u044F \u0434\u043D\u0451\u043C: \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u0442\u0435\u043D\u044C \u0438 \u043A\u0440\u0438\u043A, \u043F\u043E\u0442\u043E\u043C \u043F\u0438\u043A\u0435. \u0421\u043F\u0430\u0441\u0430\u044E\u0442 \u0442\u0440\u0430\u0432\u0430 \u0438\u043B\u0438 \u0431\u0440\u043E\u0441\u043E\u043A \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043C\u0438\u0433.\n\n\u0423\u0434\u0430\u0440\u044B \u043E \u043A\u0430\u043C\u043D\u0438, \u0434\u0435\u0440\u0435\u0432\u044C\u044F \u0438 \u0442\u0435\u043B\u0430 \u0440\u0430\u043D\u044F\u0442.\n\n\u041A\u043E\u0433\u0434\u0430 \u0441\u044B\u0442\u043E\u0441\u0442\u044C \u043D\u0430 \u043D\u0443\u043B\u0435, \u0442\u0435\u043B\u043E \u0445\u0443\u0434\u0435\u0435\u0442, \u0430 \u0437\u0430\u0442\u0435\u043C \u0437\u043C\u0435\u044F \u0442\u0435\u0440\u044F\u0435\u0442 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435."
