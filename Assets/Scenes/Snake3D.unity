  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1057706565}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.62, g: 0.63, b: 0.6, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 22
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.15
  m_Text: "WASD \u2014 \u043F\u043E\u043B\u0437\u0442\u0438, \u043C\u044B\u0448\u044C \u2014 \u043A\u0430\u043C\u0435\u0440\u0430. CTRL \u2014 \u043A\u0440\u0430\u0441\u0442\u044C\u0441\u044F, SHIFT \u2014 \u0431\u044B\u0441\u0442\u0440\u0435\u0435 (\u0442\u0440\u0430\u0442\u0438\u0442 \u0441\u0438\u043B\u044B).\n\n\u0416\u0443\u043A\u0430 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u043A\u043E\u0441\u043D\u0443\u0442\u044C\u0441\u044F. \u041C\u044B\u0448\u044C, \u043B\u044F\u0433\u0443\u0448\u043A\u0443 \u0438 \u043F\u0442\u0438\u0446\u0443 \u043B\u043E\u0432\u044F\u0442 \u0431\u0440\u043E\u0441\u043A\u043E\u043C: \u041B\u041A\u041C \u2014 \u0443\u043A\u0443\u0441, \u041F\u041A\u041C \u2014 \u0437\u0430\u043C\u0430\u0445, \u0438 \u0431\u0440\u043E\u0441\u043E\u043A \u043B\u0435\u0442\u0438\u0442 \u0434\u0430\u043B\u044C\u0448\u0435.\n\n\u041A\u0440\u043E\u043B\u0438\u043A\u0430 \u0431\u0440\u043E\u0441\u043E\u043A \u0442\u043E\u043B\u044C\u043A\u043E \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u2014 \u0434\u0435\u0440\u0436\u0438\u0442\u0435 F, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0434\u0443\u0448\u0438\u0442\u044C, \u043F\u043E\u043A\u0430 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0441\u0438\u043B."
